{
  "manifest_version": 3,
  "name": "Rule34Video Media Filter",
  "version": "0.1.0",
  "description": "Local subscription catalogue, filtering, sorting, and metadata tools for Rule34Video.",
  "permissions": ["storage"],
  "host_permissions": ["https://rule34video.com/*", "https://www.rule34video.com/*", "https://api.github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://rule34video.com/*", "https://www.rule34video.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/shared/namespace.js",
        "src/shared/build-info.js",
        "src/shared/browser-api.js",
        "src/shared/constants.js",
        "src/storage/seen-store.js",
        "src/storage/favorite-store.js",
        "src/utils/logger.js",
        "src/utils/url.js",
        "src/shared/rule34video-video-url.js",
        "src/shared/upload-date.js",
        "src/storage/settings.js",
        "src/storage/ui-state.js",
        "src/storage/db.js",
        "src/storage/local-data-cache.js",
        "src/storage/data-operation-lock.js",
        "src/storage/settings-data.js",
        "src/storage/settings-data-local-state.js",
        "src/diagnostics/detail-diagnostic-export.js",
        "src/jobs/request-scheduler.js",
        "src/jobs/job-manager.js",
        "src/jobs/site-queue-runtime.js",
        "src/jobs/queue-persistence.js",
        "src/jobs/data-maintenance-guard.js",
        "src/catalogue/parsing.js",
        "src/catalogue/card-parser.js",
        "src/catalogue/detail-parser.js",
        "src/catalogue/detail-parser-v6.js",
        "src/catalogue/favorite-detail-parser.js",
        "src/catalogue/detail-scanner.js",
        "src/jobs/detail-maintenance.js",
        "src/jobs/detail-operation-lifecycle.js",
        "src/jobs/detail-schema-v6-maintenance.js",
        "src/catalogue/feed-discovery.js",
        "src/catalogue/subscription-membership.js",
        "src/catalogue/subscription-membership-harden.js",
        "src/catalogue/catalogue-reconciliation.js",
        "src/catalogue/catalogue-scanner.js",
        "src/catalogue/recent-update-bounded.js",
        "src/catalogue/catalogue-cancel-storage.js",
        "src/catalogue/catalogue-maintenance.js",
        "src/filters/filter-engine.js",
        "src/filters/filter-quality.js",
        "src/filters/filter-duplicates.js",
        "src/filters/filter-favorites.js",
        "src/filters/filter-seen.js",
        "src/filters/upload-date-integration.js",
        "src/filters/filter-evaluation-performance.js",
        "src/filters/vocabulary-cache.js",
        "src/filters/filter-draft.js",
        "src/filters/filter-advanced-draft.js",
        "src/filters/filter-state.js",
        "src/sort/sorter.js",
        "src/storage/backup-schema.js",
        "src/storage/backup-schema-local-state.js",
        "src/storage/settings-backup-preference-sync.js",
        "src/storage/settings-data-hardening.js",
        "src/storage/cloud-sync.js",
        "src/ui/shell.js",
        "src/ui/cloud-main-buttons.js",
        "src/ui/paginator-model.js",
        "src/ui/date-control.js",
        "src/ui/entity-picker.js",
        "src/ui/filters.js",
        "src/ui/advanced-filter-editor.js",
        "src/ui/advanced-filter-field-additions.js",
        "src/ui/filter-modals.js",
        "src/ui/filter-wording-polish.js",
        "src/ui/filter-modal-polish.js",
        "src/ui/filter-layout-followup.js",
        "src/ui/local-grid.js",
        "src/ui/local-grid-artist-labels.js",
        "src/ui/local-grid-touch-previews.js",
        "src/ui/settings-draft-bridge.js",
        "src/ui/cloud-sync-ui.js",
        "src/ui/settings.js",
        "src/ui/settings-retry-cap.js",
        "src/ui/settings-p2-ui.js",
        "src/ui/settings-cloud-player-ui.js",
        "src/ui/settings-layout-followup.js",
        "src/ui/queue/queue-view-model.js",
        "src/ui/queue/queue-maintenance-model.js",
        "src/ui/queue/queue-maintenance-state.js",
        "src/ui/queue/queue-timing-model.js",
        "src/ui/queue/queue.js",
        "src/ui/queue/queue-maintenance.js",
        "src/ui/queue/queue-diagnostic-polish.js",
        "src/ui/queue/queue-operation-controls.js",
        "src/ui/accessibility-hardening.js",
        "src/content/subscriptions-controller.js",
        "src/content/maintenance-controller.js",
        "src/content/operation-lifecycle-controller.js",
        "src/content/filter-ui-hooks.js",
        "src/content/filter-page-preservation.js",
        "src/content/settings-controller.js",
        "src/content/cloud-sync-controller.js",
        "src/content/recent-auto-update-controller.js",
        "src/content/phase10-hardening-controller.js",
        "src/content/local-filter-context.js",
        "src/content/filter-vocabulary-performance.js",
        "src/content/seen-filter-controller.js",
        "src/content/filter-modal-stability-controller.js",
        "src/content/detail-rate-limit-recovery-controller.js",
        "src/content/mobile-runtime-stability-controller.js",
        "src/content/filter-touch-followup-controller.js",
        "src/content/runtime-presentation-performance.js",
        "src/content/site-queue-continuation-controller.js",
        "src/content/video-player-controls.js",
        "src/content/video-player-feedback-layer-fix.js",
        "src/content/video-page-seen.js",
        "src/content/video-page-favorite-sync.js",
        "src/content/main.js"
      ]
    },
    {
      "matches": ["https://rule34video.com/my/subscriptions*", "https://www.rule34video.com/my/subscriptions*"],
      "run_at": "document_idle",
      "css": [
        "src/ui/styles.css",
        "src/ui/local-grid-artist-labels.css",
        "src/ui/filters.css",
        "src/ui/filters-polish.css",
        "src/ui/filter-parent-minimal.css",
        "src/ui/advanced-filter.css",
        "src/ui/advanced-filter-followup.css",
        "src/ui/settings.css",
        "src/ui/cloud-sync.css",
        "src/ui/cloud-sync-followup.css",
        "src/ui/mobile.css",
        "src/ui/mobile-followup.css",
        "src/ui/filter-layout-followup.css"
      ]
    },
    {
      "matches": [
        "https://rule34video.com/video/*",
        "https://www.rule34video.com/video/*",
        "https://rule34video.com/videos/*",
        "https://www.rule34video.com/videos/*"
      ],
      "run_at": "document_idle",
      "css": ["src/ui/video-page-seen.css", "src/ui/video-player-controls.css"]
    },
    {
      "matches": ["https://rule34video.com/*", "https://www.rule34video.com/*"],
      "run_at": "document_start",
      "js": ["src/auth/auto-signin.js", "src/auth/auto-signin-return.js", "src/auth/auto-signin-reliability.js"]
    }
  ]
}
